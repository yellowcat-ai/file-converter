# CloudConvert API Key - 复制此文件为 .env 并填入你的 key
# 获取方式：https://cloudconvert.com/api/dashboard -> Create API Token
CLOUDCONVERT_API_KEY=your_api_key_here

# MinerU 精准解析 API token - 只有用 worker/local-proxy.mjs（本机代理）时才需要
# 获取方式：https://mineru.net/apiManage/token （有效期 90 天，不支持续期，到期重新创建）
# 部署到 Cloudflare Worker 的话不要写在这里，用 npx wrangler secret put MINERU_API_TOKEN
MINERU_API_TOKEN=your_mineru_token_here
